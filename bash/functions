#!/bin/bash

function s() {
	reset
	kitty +kitten ssh "$@" || ssh "$@"
}

function _opencode_auth() {
	local opencode_bin="${OPENCODE_BIN:-${HOME}/.opencode/bin/opencode}"
	local password

	if ! password=$("${opencode_bin}" service get password 2>/dev/null) || [[ -z "${password}" ]]; then
		echo "Could not read the OpenCode service password from its configuration." >&2
		return 1
	fi

	OPENCODE_SERVER_PASSWORD="${password}"
}

function _opencode_curl() {
	_opencode_auth || return 1
	local username="${OPENCODE_SERVER_USERNAME:-opencode}"
	printf 'user = "%s:%s"\n' "${username}" "${OPENCODE_SERVER_PASSWORD}" | \
		env -u LD_LIBRARY_PATH curl --config - "$@"
}

function _opencode_check_cpu_quota() {
	local unit="opencode-shared-4096-cpuquota.service"
	local quota

	if ! quota=$(systemctl --user show "${unit}" --property=CPUQuotaPerSecUSec --value); then
		echo "Could not read the CPU quota for ${unit}." >&2
		return 1
	fi

	if [[ "${quota}" != "2s" ]]; then
		echo "Refusing to start/restart ${unit}: CPU quota is ${quota:-unset}, expected 200% (2s)." >&2
		return 1
	fi
}

function opstatus() {
	systemctl --user show opencode-shared-4096-cpuquota.service \
		--property=ActiveState --property=SubState --property=MainPID --property=CPUQuotaPerSecUSec
}

function opstart() {
	local unit="opencode-shared-4096-cpuquota.service"
	_opencode_check_cpu_quota || return 1
	systemctl --user start "${unit}"
}

function opstop() {
	systemctl --user stop opencode-shared-4096-cpuquota.service
}

function ops() {
	if [[ "$#" -gt 0 ]]; then
		echo "ops manages the shared OpenCode server; it does not accept serve options." >&2
		return 2
	fi
	opstart
}

function opactive() {
	_opencode_auth || return 1
	local port="${OPENCODE_PORT:-4096}"
	local dir
	local active
	local sessions

	dir=$(pwd -P) || return 1

	if ! active=$(_opencode_curl --fail --silent --show-error "http://127.0.0.1:${port}/api/session/active"); then
		echo "OpenCode active sessions could not be queried." >&2
		return 1
	fi

	if ! sessions=$(_opencode_curl --fail --silent --show-error --get --data-urlencode "directory=${dir}" --data-urlencode "limit=1000" "http://127.0.0.1:${port}/api/session"); then
		echo "OpenCode sessions could not be queried." >&2
		return 1
	fi

	printf '%s\0%s' "$active" "$sessions" | perl -MJSON::PP -e '
		my ($active, $sessions) = split /\0/, do { local $/; <STDIN> }, 2;
		$active = decode_json($active);
		$sessions = decode_json($sessions);
		$active = $active->{data} if ref($active) eq "HASH" && ref($active->{data}) eq "HASH";
		$sessions = $sessions->{data} if ref($sessions) eq "HASH";
		die "Unexpected OpenCode API response\n" unless ref($active) eq "HASH" && ref($sessions) eq "ARRAY";
		my %sessions = map { $_->{id} => $_ } @$sessions;
		my @active = grep { exists $sessions{$_} } keys %$active;
		exit 0 unless @active;
		print "STATE\tDIRECTORY\tSESSION\tTITLE\n";
		for my $id (sort @active) {
			my $session = $sessions{$id} // {};
			my $location = $session->{location};
			my $directory = ref($location) eq "HASH" ? ($location->{directory} // "<unknown>") : ($session->{directory} // "<unknown>");
			printf "%s\t%s\t%s\t%s\n", "active", $directory, $id, $session->{title} // "";
		}
	' || return 1
}

function oprestart() {
	_opencode_auth || return 1
	local port="${OPENCODE_PORT:-4096}"
	local active
	local active_count

	if ! active=$(_opencode_curl --fail --silent --show-error "http://127.0.0.1:${port}/api/session/active"); then
		echo "OpenCode server status could not be queried; refusing to restart."
		return 1
	fi

	if ! active_count=$(printf '%s' "$active" | perl -MJSON::PP -e '
		my $response = decode_json(do { local $/; <STDIN> });
		my $sessions = ref($response) eq "HASH" ? $response->{data} : undef;
		die "Unexpected OpenCode API response\n" unless ref($sessions) eq "HASH";
		print scalar keys %$sessions;
	'); then
		echo "OpenCode active-session response was invalid; refusing to restart." >&2
		return 1
	fi

	if [[ "${active_count}" -gt 0 ]]; then
		echo "OpenCode has ${active_count} active session(s); refusing to restart."
		return 1
	fi

	_opencode_check_cpu_quota || return 1
	systemctl --user restart opencode-shared-4096-cpuquota.service
}

function lbd() {
	if [ -z "$(type -P lb-conda)" ]; then
		if [ ! -f "/cvmfs/lhcb.cern.ch/lib/LbEnv" ]; then
			echo "lb-conda command not available"
			return 127
		fi

		local saved_args=("$@")
		set --
		source /cvmfs/lhcb.cern.ch/lib/LbEnv
		set -- "${saved_args[@]}"
	fi

	command lb-conda default "$@"
}

function ganga_session() {
	local here
	local proxy

	if [[ $# -gt 1 ]]; then
		echo "Usage: ganga_session [GANGA_DIRECTORY]" >&2
		return 2
	fi

	here=$(builtin cd -- "${1:-.}" && pwd) || return 1
	proxy=${X509_USER_PROXY:-"${HOME}/.grid.proxy"}
	if [[ ! -f ${proxy} ]]; then
		echo "LHCb Grid proxy does not exist: ${proxy}" >&2
		return 2
	fi

	/usr/bin/apptainer exec \
		--bind /cvmfs:/cvmfs:ro \
		--bind "${HOME}:${HOME}" \
		--bind "${here}:${here}" \
		--pwd "${here}" \
		--env X509_USER_PROXY="${proxy}" \
		/cvmfs/lhcb.cern.ch/containers/os-base/alma9-devel/prod/amd64/ \
		bash -lc "source /cvmfs/lhcb.cern.ch/lib/LbEnv --sh && exec /cvmfs/lhcb.cern.ch/lib/bin/ganga -i"
}

function op() {
	_opencode_auth || return 1
	local port="${OPENCODE_PORT:-4096}"
	local opencode_bin="${OPENCODE_BIN:-${HOME}/.opencode/bin/opencode}"
	local dir="${PWD:-$(pwd -P)}"
	local tmux_env="${TMUX:-}"
	local tmux_pane_env="${TMUX_PANE:-}"
	if [[ -d "/proc/${BASHPID}/cwd" ]]; then
		dir="/proc/${BASHPID}/cwd"
	fi
	TMUX="${tmux_env}" TMUX_PANE="${tmux_pane_env}" OPENCODE_SERVER_USERNAME="${OPENCODE_SERVER_USERNAME:-opencode}" OPENCODE_SERVER_PASSWORD="${OPENCODE_SERVER_PASSWORD}" \
		taskset --cpu-list 0 nice -n 10 "${opencode_bin}" --server "http://127.0.0.1:${port}" "$@" "${dir}"
}

